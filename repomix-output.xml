};

const METRIC_LABELS = {
  team_possession_minutes: 'Possession (minutes)',
  team_possession_pct: 'Possession',
  team_possession_third_att_pct: 'Possession tiers offensif',
  team_possession_third_def_pct: 'Possession tiers defensif',
